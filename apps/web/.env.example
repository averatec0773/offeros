# Optional fallbacks. The primary way to configure AI is in the app:
# Settings → AI (keys are stored locally in ~/.offeros and never leave
# this machine except to call your chosen provider).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: override the SQLite location (default ~/.offeros/offeros.db)
# OFFEROS_DB_PATH=/absolute/path/offeros.db
