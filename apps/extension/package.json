{
  "name": "@offeros/extension",
  "version": "0.0.0",
  "private": true,
  "description": "Autofill job applications from your local OfferOS profile \u2014 Greenhouse, Lever, Ashby, iCIMS and Workday. Every field is reported back so you can check it before you submit.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/averatec0773/offeros.git",
    "directory": "apps/extension"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build && node scripts/dev-reload-stamp.mjs",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e-sidepanel.mjs",
    "adaptation:pdf": "node scripts/resume-adaptation.mjs",
    "probe:workday": "node scripts/workday-skills-probe.mjs",
    "test:watch": "vitest",
    "postinstall": "wxt prepare",
    "e2e:enable": "node scripts/e2e-enable-on-page.mjs"
  },
  "dependencies": {
    "@offeros/autofill": "*",
    "@offeros/core": "*",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/chrome": "^0.2.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.1.5",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.27.7",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wxt": "^0.20.27"
  }
}
